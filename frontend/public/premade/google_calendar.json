{
  "baseUrl": "https://www.googleapis.com/calendar/v3",
  "auth": [{ "type": "bearer_token" }],
  "tools": [
    {
      "name": "calendar_list_calendars",
      "description": "List all calendars on the authenticated user's calendar list (primary, shared, subscribed).",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "maxResults": { "type": "integer", "description": "Maximum calendars to return (default 100)" },
          "minAccessRole": { "type": "string", "description": "Minimum access role: 'freeBusyReader', 'reader', 'writer', 'owner'" },
          "showHidden": { "type": "boolean", "description": "Include hidden calendars" },
          "showDeleted": { "type": "boolean", "description": "Include deleted calendars" },
          "pageToken": { "type": "string", "description": "Pagination token from previous response" }
        },
        "required": []
      },
      "handler": { "method": "GET", "path": "/users/me/calendarList", "headers": {}, "query_params": ["maxResults", "minAccessRole", "showHidden", "showDeleted", "pageToken"], "fixed_query_params": {} }
    },
    {
      "name": "calendar_get_calendar",
      "description": "Get metadata about a specific calendar (title, description, timezone, access role).",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "calendarId": { "type": "string", "description": "Calendar ID. Use 'primary' for the user's main calendar, or an email/ID from calendarList." }
        },
        "required": ["calendarId"]
      },
      "handler": { "method": "GET", "path": "/calendars/{calendarId}", "headers": {}, "query_params": [], "fixed_query_params": {} }
    },
    {
      "name": "calendar_insert_calendar",
      "description": "Add an existing calendar to the authenticated user's calendar list (subscribe to it).",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "The calendar ID to subscribe to" },
          "colorId": { "type": "string", "description": "Color ID for this calendar on the user's list" },
          "defaultReminders": { "type": "array", "description": "Default reminders, e.g. [{method: 'email', minutes: 10}]" }
        },
        "required": ["id"]
      },
      "handler": { "method": "POST", "path": "/users/me/calendarList", "headers": {}, "query_params": [], "fixed_query_params": {} }
    },
    {
      "name": "calendar_create_calendar",
      "description": "Create a new calendar owned by the authenticated user.",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "summary": { "type": "string", "description": "Calendar name/title" },
          "description": { "type": "string", "description": "Optional description" },
          "timeZone": { "type": "string", "description": "Timezone for the calendar, e.g. 'America/New_York'" },
          "location": { "type": "string", "description": "Geographic location" }
        },
        "required": ["summary"]
      },
      "handler": { "method": "POST", "path": "/calendars", "headers": {}, "query_params": [], "fixed_query_params": {} }
    },
    {
      "name": "calendar_delete_calendar",
      "description": "Delete a calendar owned by the authenticated user.",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "calendarId": { "type": "string", "description": "Calendar ID to delete (must be owner)" }
        },
        "required": ["calendarId"]
      },
      "handler": { "method": "DELETE", "path": "/calendars/{calendarId}", "headers": {}, "query_params": [], "fixed_query_params": {} }
    },
    {
      "name": "calendar_list_events",
      "description": "List events from a calendar. Supports date range filtering, text search, and recurring event expansion.",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "calendarId": { "type": "string", "description": "Calendar ID. Use 'primary' for main calendar." },
          "timeMin": { "type": "string", "description": "Lower bound (RFC3339) for event start time, e.g. '2026-05-01T00:00:00Z'" },
          "timeMax": { "type": "string", "description": "Upper bound (RFC3339) for event start time" },
          "q": { "type": "string", "description": "Free-text search query across summary, description, location, attendees" },
          "maxResults": { "type": "integer", "description": "Max events to return (default 250)" },
          "orderBy": { "type": "string", "description": "'startTime' (requires singleEvents=true) or 'updated'" },
          "singleEvents": { "type": "boolean", "description": "Expand recurring events into single instances (set true to use orderBy startTime)" },
          "pageToken": { "type": "string", "description": "Pagination token" },
          "showDeleted": { "type": "boolean", "description": "Include cancelled events" }
        },
        "required": ["calendarId"]
      },
      "handler": { "method": "GET", "path": "/calendars/{calendarId}/events", "headers": {}, "query_params": ["timeMin", "timeMax", "q", "maxResults", "orderBy", "singleEvents", "pageToken", "showDeleted"], "fixed_query_params": {} }
    },
    {
      "name": "calendar_get_event",
      "description": "Get a specific event by its event ID.",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "calendarId": { "type": "string", "description": "Calendar ID (use 'primary')" },
          "eventId": { "type": "string", "description": "The event ID" },
          "timeZone": { "type": "string", "description": "Timezone to return times in" }
        },
        "required": ["calendarId", "eventId"]
      },
      "handler": { "method": "GET", "path": "/calendars/{calendarId}/events/{eventId}", "headers": {}, "query_params": ["timeZone"], "fixed_query_params": {} }
    },
    {
      "name": "calendar_create_event",
      "description": "Create a new calendar event with attendees, recurrence, reminders, and conferencing.",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "calendarId": { "type": "string", "description": "Calendar ID (use 'primary')" },
          "summary": { "type": "string", "description": "Event title" },
          "description": { "type": "string", "description": "Event description (supports HTML)" },
          "location": { "type": "string", "description": "Event location (address or place name)" },
          "start": { "type": "object", "description": "Start time: { dateTime: '2026-06-01T10:00:00', timeZone: 'America/New_York' } or { date: '2026-06-01' } for all-day" },
          "end": { "type": "object", "description": "End time in same format as start" },
          "attendees": { "type": "array", "description": "List of attendees: [{ email: 'user@example.com', displayName: 'Name' }]" },
          "recurrence": { "type": "array", "description": "RRULE/EXDATE strings, e.g. ['RRULE:FREQ=WEEKLY;BYDAY=MO,WE,FR']" },
          "reminders": { "type": "object", "description": "Reminders override: { useDefault: false, overrides: [{ method: 'email', minutes: 30 }] }" },
          "sendUpdates": { "type": "string", "description": "'all', 'externalOnly', or 'none' — controls invite emails" },
          "conferenceDataVersion": { "type": "integer", "description": "Set to 1 to add Google Meet link" }
        },
        "required": ["calendarId", "summary", "start", "end"]
      },
      "handler": { "method": "POST", "path": "/calendars/{calendarId}/events", "headers": {}, "query_params": ["sendUpdates", "conferenceDataVersion"], "fixed_query_params": {} }
    },
    {
      "name": "calendar_update_event",
      "description": "Update an existing event (PUT — replaces all writeable fields).",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "calendarId": { "type": "string", "description": "Calendar ID" },
          "eventId": { "type": "string", "description": "Event ID to update" },
          "summary": { "type": "string", "description": "New event title" },
          "description": { "type": "string", "description": "New description" },
          "location": { "type": "string", "description": "New location" },
          "start": { "type": "object", "description": "New start time" },
          "end": { "type": "object", "description": "New end time" },
          "attendees": { "type": "array", "description": "Updated attendee list" },
          "sendUpdates": { "type": "string", "description": "'all', 'externalOnly', or 'none'" }
        },
        "required": ["calendarId", "eventId"]
      },
      "handler": { "method": "PUT", "path": "/calendars/{calendarId}/events/{eventId}", "headers": {}, "query_params": ["sendUpdates"], "fixed_query_params": {} }
    },
    {
      "name": "calendar_patch_event",
      "description": "Partially update an event — only specified fields are changed (PATCH).",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "calendarId": { "type": "string", "description": "Calendar ID" },
          "eventId": { "type": "string", "description": "Event ID" },
          "summary": { "type": "string", "description": "New title" },
          "description": { "type": "string", "description": "New description" },
          "location": { "type": "string", "description": "New location" },
          "start": { "type": "object", "description": "New start time" },
          "end": { "type": "object", "description": "New end time" },
          "sendUpdates": { "type": "string", "description": "'all', 'externalOnly', or 'none'" }
        },
        "required": ["calendarId", "eventId"]
      },
      "handler": { "method": "PATCH", "path": "/calendars/{calendarId}/events/{eventId}", "headers": {}, "query_params": ["sendUpdates"], "fixed_query_params": {} }
    },
    {
      "name": "calendar_delete_event",
      "description": "Delete a calendar event. Sends cancellation emails to attendees by default.",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "calendarId": { "type": "string", "description": "Calendar ID" },
          "eventId": { "type": "string", "description": "Event ID to delete" },
          "sendUpdates": { "type": "string", "description": "'all', 'externalOnly', or 'none'" }
        },
        "required": ["calendarId", "eventId"]
      },
      "handler": { "method": "DELETE", "path": "/calendars/{calendarId}/events/{eventId}", "headers": {}, "query_params": ["sendUpdates"], "fixed_query_params": {} }
    },
    {
      "name": "calendar_quick_add_event",
      "description": "Create an event from a human-readable text string, e.g. 'Team standup tomorrow at 9am for 30 minutes'.",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "calendarId": { "type": "string", "description": "Calendar ID (use 'primary')" },
          "text": { "type": "string", "description": "Natural language event description, e.g. 'Dentist appointment Friday at 3pm'" },
          "sendUpdates": { "type": "string", "description": "'all', 'externalOnly', or 'none'" }
        },
        "required": ["calendarId", "text"]
      },
      "handler": { "method": "POST", "path": "/calendars/{calendarId}/events/quickAdd", "headers": {}, "query_params": ["text", "sendUpdates"], "fixed_query_params": {} }
    },
    {
      "name": "calendar_move_event",
      "description": "Move an event from one calendar to another.",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "calendarId": { "type": "string", "description": "Source calendar ID" },
          "eventId": { "type": "string", "description": "Event ID to move" },
          "destination": { "type": "string", "description": "Target calendar ID" },
          "sendUpdates": { "type": "string", "description": "'all', 'externalOnly', or 'none'" }
        },
        "required": ["calendarId", "eventId", "destination"]
      },
      "handler": { "method": "POST", "path": "/calendars/{calendarId}/events/{eventId}/move", "headers": {}, "query_params": ["destination", "sendUpdates"], "fixed_query_params": {} }
    },
    {
      "name": "calendar_query_freebusy",
      "description": "Check the free/busy status of calendars or users for a given time range. Useful for scheduling.",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "timeMin": { "type": "string", "description": "Start of the interval (RFC3339), e.g. '2026-06-01T00:00:00Z'" },
          "timeMax": { "type": "string", "description": "End of the interval (RFC3339)" },
          "timeZone": { "type": "string", "description": "Timezone, e.g. 'America/New_York'" },
          "items": { "type": "array", "description": "Calendars to check: [{ id: 'primary' }, { id: 'user@example.com' }]" }
        },
        "required": ["timeMin", "timeMax", "items"]
      },
      "handler": { "method": "POST", "path": "/freeBusy", "headers": {}, "query_params": [], "fixed_query_params": {} }
    },
    {
      "name": "calendar_list_acl",
      "description": "List access control rules for a calendar (who has access and their permission level).",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "calendarId": { "type": "string", "description": "Calendar ID" }
        },
        "required": ["calendarId"]
      },
      "handler": { "method": "GET", "path": "/calendars/{calendarId}/acl", "headers": {}, "query_params": [], "fixed_query_params": {} }
    },
    {
      "name": "calendar_insert_acl",
      "description": "Share a calendar with another user and set their access level.",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "calendarId": { "type": "string", "description": "Calendar ID to share" },
          "role": { "type": "string", "description": "Access level: 'freeBusyReader', 'reader', 'writer', 'owner'" },
          "scope": { "type": "object", "description": "Who to share with: { type: 'user', value: 'user@example.com' } or { type: 'domain', value: 'example.com' }" },
          "sendNotifications": { "type": "boolean", "description": "Send email notification to the user" }
        },
        "required": ["calendarId", "role", "scope"]
      },
      "handler": { "method": "POST", "path": "/calendars/{calendarId}/acl", "headers": {}, "query_params": ["sendNotifications"], "fixed_query_params": {} }
    }
  ]
}
