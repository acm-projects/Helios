          "first_air_date_year": { "type": "integer", "description": "Filter by first air date year" },
          "vote_average.gte": { "type": "number", "description": "Minimum rating" },
          "with_networks": { "type": "string", "description": "Network ID, e.g. '213' for Netflix" },
          "with_status": { "type": "string", "description": "Show status: '0' (Returning), '1' (Planned), '2' (In Production), '3' (Ended), '4' (Cancelled), '5' (Pilot)" },
          "page": { "type": "integer", "description": "Page number" },
          "language": { "type": "string", "description": "Response language" }
        },
        "required": []
