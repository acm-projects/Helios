    {
      "name": "tmdb_discover_movies",
      "description": "Discover movies using advanced filters: genres, year range, rating, runtime, certification, and sort options.",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "sort_by": { "type": "string", "description": "Sort by: 'popularity.desc', 'vote_average.desc', 'release_date.desc', 'revenue.desc'" },
          "with_genres": { "type": "string", "description": "Genre IDs to include (comma-separated AND, pipe-separated OR), e.g. '28,12' for Action AND Adventure" },
          "without_genres": { "type": "string", "description": "Genre IDs to exclude" },
          "primary_release_year": { "type": "integer", "description": "Filter by release year" },
          "primary_release_date.gte": { "type": "string", "description": "Released on or after YYYY-MM-DD" },
          "primary_release_date.lte": { "type": "string", "description": "Released on or before YYYY-MM-DD" },
          "vote_average.gte": { "type": "number", "description": "Minimum TMDB rating (0-10)" },
          "vote_average.lte": { "type": "number", "description": "Maximum TMDB rating" },
          "vote_count.gte": { "type": "integer", "description": "Minimum vote count (to filter out obscure titles)" },
          "with_runtime.gte": { "type": "integer", "description": "Minimum runtime in minutes" },
          "with_runtime.lte": { "type": "integer", "description": "Maximum runtime in minutes" },
          "with_cast": { "type": "string", "description": "Person IDs for cast members (comma = AND, pipe = OR)" },
          "with_crew": { "type": "string", "description": "Person IDs for crew members" },
          "with_original_language": { "type": "string", "description": "ISO 639-1 language code, e.g. 'en' for English-language films" },
          "page": { "type": "integer", "description": "Page number" },
          "language": { "type": "string", "description": "Response language code" }
        },
        "required": []
      },
      "handler": { "method": "GET", "path": "/discover/movie", "headers": {}, "query_params": ["sort_by", "with_genres", "without_genres", "primary_release_year", "primary_release_date.gte", "primary_release_date.lte", "vote_average.gte", "vote_average.lte", "vote_count.gte", "with_runtime.gte", "with_runtime.lte", "with_cast", "with_crew", "with_original_language", "page", "language"], "fixed_query_params": {} }
    },
