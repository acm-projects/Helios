{
  "baseUrl": "https://api.themoviedb.org/3",
  "auth": [{ "type": "bearer_token" }],
  "tools": [
    {
      "name": "tmdb_search_movies",
      "description": "Search for movies by title. Returns matching movies with basic details.",
      "enabled": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "Movie title to search for" },
          "year": { "type": "integer", "description": "Filter by release year" },
          "primary_release_year": { "type": "integer", "description": "Filter by primary release year" },
          "page": { "type": "integer", "description": "Page number (default 1)" },
          "language": { "type": "string", "description": "Language code, e.g. 'en-US'" },
          "include_adult": { "type": "boolean", "description": "Include adult titles" },
          "region": { "type": "string", "description": "Region for release dates (ISO 3166-1 code)" }
        },
        "required": ["query"]
      },
      "handler": { "method": "GET", "path": "/search/movie", "headers": {}, "query_params": ["query", "year", "primary_release_year", "page", "language", "include_adult", "region"], "fixed_query_params": {} }
    },
    {
      "name": "tmdb_search_tv",
